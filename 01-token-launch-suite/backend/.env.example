# Copy to .env and fill in. Every value is validated at boot, so a typo fails fast.

NODE_ENV=development
LOG_LEVEL=debug

PORT=4001
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql://tokensuite:tokensuite@localhost:5433/tokensuite?schema=public

CHAIN_ID=11155111
RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY

# All six are printed by the deploy script.
TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
TIMELOCK_ADDRESS=0x0000000000000000000000000000000000000000
GOVERNOR_ADDRESS=0x0000000000000000000000000000000000000000
VESTING_ADDRESS=0x0000000000000000000000000000000000000000
DISTRIBUTOR_ADDRESS=0x0000000000000000000000000000000000000000
VAULT_ADDRESS=0x0000000000000000000000000000000000000000

# Blocks below (head - CONFIRMATIONS) are final. Above it, logs are re-scanned every pass so a
# reorg cannot leave a phantom claim in the database.
CONFIRMATIONS=12
INDEXER_BATCH_SIZE=2000
INDEXER_POLL_INTERVAL=12
DEPLOY_BLOCK=0

# How often to snapshot vault share price for the yield chart, in seconds.
VAULT_SNAPSHOT_INTERVAL=3600

# Required for POST /airdrop/build. Publishing a Merkle root decides who receives tokens, so that
# route is not open. Minimum 16 characters.
ADMIN_API_KEY=
