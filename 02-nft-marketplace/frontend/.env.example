# Chain the frontend talks to. 31337 = local Anvil, 11155111 = Sepolia.
NEXT_PUBLIC_CHAIN_ID=11155111

# Backend API base. Must match the backend's CORS_ORIGINS setting.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Printed by the deploy script.
NEXT_PUBLIC_MARKETPLACE_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_AUCTION_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_COLLECTION_ADDRESS=0x0000000000000000000000000000000000000000

# WETH is required for offers, since a signature cannot escrow native ETH.
NEXT_PUBLIC_WETH_ADDRESS=0x0000000000000000000000000000000000000000

# From https://cloud.walletconnect.com. Without it, only injected wallets work.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
