// Order book and indexed chain state for the NFT marketplace.
//
// Two kinds of data live here and they are deliberately kept apart:
//
//   * Off-chain intent  - signed orders that have not settled. These exist only here; the chain
//                         has never seen them. They can be cancelled or expire without a trace.
//   * Indexed on-chain  - what actually happened. Rebuildable from logs at any time, so this side
//                         is treated as a cache that can be dropped and replayed.
//
// Amounts are stored as strings, not floats or ints. A uint256 does not fit in a JS number and
// Prisma's Decimal is awkward to compare against on-chain values, so canonical decimal strings
// keep the round trip exact.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderSide {
  LISTING
  OFFER
}

enum TokenStandard {
  ERC721
  ERC1155
}

enum OrderStatus {
  /// Signed, valid, and fillable right now.
  OPEN
  /// Fully filled on-chain.
  FILLED
  /// Cancelled on-chain, either individually or by a nonce bump.
  CANCELLED
  /// Past its end time.
  EXPIRED
  /// The maker no longer owns the asset or revoked approval, so a fill would revert.
  INVALID
}

enum AuctionStatus {
  ACTIVE
  SETTLED
  CANCELLED
}

/// A signed off-chain order. The signature is the only thing that makes it real.
model Order {
  /// EIP-712 digest, which is also the on-chain identifier.
  hash            String        @id
  maker           String
  collection      String
  tokenId         String
  amount          String
  currency        String
  price           String
  /// Price per single unit, denormalised so floor-price queries do not need arithmetic in SQL.
  unitPrice       String
  startTime       DateTime
  endTime         DateTime
  salt            String
  nonce           String
  side            OrderSide
  tokenStandard   TokenStandard
  signature       String
  status          OrderStatus   @default(OPEN)
  /// Units already filled on-chain. Only ERC-1155 orders ever exceed 1.
  filledAmount    String        @default("0")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  fills           Fill[]

  // Serving a collection page means "open listings for this collection, cheapest first".
  @@index([collection, side, status, unitPrice])
  // Serving a profile page means "everything this maker signed, newest first".
  @@index([maker, status, createdAt])
  // The expiry sweep looks for open orders whose end time has passed.
  @@index([status, endTime])
  @@index([collection, tokenId, side, status])
}

/// A settled trade, indexed from an OrderFilled log.
model Fill {
  id           String        @id @default(cuid())
  /// Nullable because of the SetNull below. A fill outlives the order it filled, and a not-null
  /// column would make deleting a filled order violate its own constraint.
  orderHash    String?
  order        Order?        @relation(fields: [orderHash], references: [hash], onDelete: SetNull)
  maker        String
  taker        String
  collection   String
  tokenId      String
  amount       String
  currency     String
  price        String
  side         OrderSide
  txHash       String
  logIndex     Int
  blockNumber  BigInt
  blockTime    DateTime

  // A log is uniquely identified by its transaction and position within it. This is what makes
  // reindexing idempotent: replaying the same range cannot double-count a trade.
  @@unique([txHash, logIndex])
  @@index([collection, blockTime])
  @@index([collection, tokenId, blockTime])
  @@index([maker])
  @@index([taker])
}

/// Current ownership, maintained from Transfer logs.
model TokenOwnership {
  id          String   @id @default(cuid())
  collection  String
  tokenId     String
  owner       String
  /// Always "1" for ERC-721; the held quantity for ERC-1155.
  balance     String   @default("1")
  updatedAt   DateTime @updatedAt

  @@unique([collection, tokenId, owner])
  @@index([owner])
  @@index([collection, tokenId])
}

/// Token-level metadata, resolved from tokenURI and cached.
model TokenMetadata {
  id            String   @id @default(cuid())
  collection    String
  tokenId       String
  name          String?
  description   String?
  imageUrl      String?
  /// Cached thumbnail, generated by the image worker.
  thumbnailUrl  String?
  /// Raw trait array as returned by the metadata document.
  attributes    Json?
  /// Null until the collection reveals, so the UI can show a placeholder.
  revealedAt    DateTime?
  fetchedAt     DateTime @default(now())

  @@unique([collection, tokenId])
  @@index([collection])
}

/// A tracked collection and its rolled-up stats.
model Collection {
  address        String   @id
  name           String?
  symbol         String?
  standard       TokenStandard @default(ERC721)
  /// Block the contract was deployed in, so a backfill knows where to start.
  deployBlock    BigInt
  totalSupply    String   @default("0")
  /// Cheapest open listing, denominated in the collection's primary currency. Null when unlisted.
  floorPrice     String?
  volumeAllTime  String   @default("0")
  volume24h      String   @default("0")
  ownerCount     Int      @default(0)
  isVerified     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// An on-chain auction, mirrored from the auction house.
model Auction {
  /// On-chain auction id.
  id              String        @id
  seller          String
  collection      String
  tokenId         String
  amount          String
  currency        String
  reservePrice    String
  highestBid      String?
  highestBidder   String?
  startTime       DateTime
  /// Moves forward when a late bid triggers the anti-snipe extension.
  endTime         DateTime
  tokenStandard   TokenStandard
  status          AuctionStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  bids            Bid[]

  @@index([status, endTime])
  @@index([collection, status])
  @@index([seller])
}

model Bid {
  id           String   @id @default(cuid())
  auctionId    String
  auction      Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidder       String
  amount       String
  txHash       String
  logIndex     Int
  blockNumber  BigInt
  blockTime    DateTime

  @@unique([txHash, logIndex])
  @@index([auctionId, blockTime])
  @@index([bidder])
}

/// A Merkle allowlist for one mint phase, plus the leaves needed to serve proofs.
model Allowlist {
  id          String            @id @default(cuid())
  collection  String
  phaseId     Int
  root        String
  createdAt   DateTime          @default(now())

  entries     AllowlistEntry[]

  @@unique([collection, phaseId])
}

model AllowlistEntry {
  id           String    @id @default(cuid())
  allowlistId  String
  allowlist    Allowlist @relation(fields: [allowlistId], references: [id], onDelete: Cascade)
  address      String
  allowance    Int
  /// Position in the sorted leaf array, so a proof can be rebuilt deterministically.
  leafIndex    Int

  @@unique([allowlistId, address])
  @@index([address])
}

/// Per-contract indexing cursor.
///
/// `lastSafeBlock` trails the chain head by a confirmation depth. Anything at or below it is
/// treated as final; anything above it may still be reorganised out and is re-scanned each pass.
model IndexerCursor {
  id             String   @id
  contract       String
  lastSafeBlock  BigInt
  updatedAt      DateTime @updatedAt

  @@unique([contract])
}
