# Copy to .env and fill in. Every value is validated at boot, so a typo fails fast with a clear
# message rather than surfacing as a confusing runtime error later.

NODE_ENV=development
LOG_LEVEL=debug

PORT=4000
HOST=0.0.0.0
# Comma separated. Must include the frontend's origin or browser requests are blocked.
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql://marketplace:marketplace@localhost:5432/marketplace?schema=public

# 11155111 = Sepolia, 1 = Ethereum mainnet
CHAIN_ID=11155111
RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY

# Fill these in after running the deploy script. It prints all three.
MARKETPLACE_ADDRESS=0x0000000000000000000000000000000000000000
AUCTION_ADDRESS=0x0000000000000000000000000000000000000000
COLLECTION_ADDRESS=0x0000000000000000000000000000000000000000

# Blocks below (head - CONFIRMATIONS) are treated as final. Anything above is re-scanned every pass,
# so a reorg cannot leave a phantom sale in the database.
CONFIRMATIONS=12

# Blocks per eth_getLogs call. Most public RPCs reject much wider ranges.
INDEXER_BATCH_SIZE=2000
INDEXER_POLL_INTERVAL=12

# Where the contracts were deployed. Backfilling from genesis would scan millions of empty blocks.
DEPLOY_BLOCK=0

IPFS_GATEWAY=https://ipfs.io/ipfs/
# Only needed for uploading metadata, not for reading it.
PINATA_JWT=
